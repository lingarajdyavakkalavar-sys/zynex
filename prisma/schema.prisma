generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  ADMIN
}

enum ExamType {
  GATE
  CAT
}

enum Status {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  MARKED_FOR_REVISION
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum QuizMode {
  PRACTICE
  TIMED_TEST
  REVISION
  SECTIONAL
  FULL_TEST
  PREVIOUS_YEAR
  MOCK_TEST
}

enum SourceType {
  OFFICIAL_PAPER
  ANSWER_KEY
  SYLLABUS
  PDF_UPLOAD
  PASTED_TEXT
  WEB_URL
  AI_GENERATED
}

enum QuestionType {
  MCQ
  MSQ
  NAT
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  imageUrl      String?
  role          Role      @default(STUDENT)
  examType      ExamType  @default(GATE)
  targetExam    String?
  phone         String?
  bio           String?
  studyHours    Float     @default(0)
  streakDays    Int       @default(0)
  lastActiveAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  mcqAttempts    MCQAttempt[]
  quizSessions   QuizSession[]
  studySessions  StudySession[]
  revisionNotes  RevisionNote[]
  flashcards     Flashcard[]
  bookmarks      Bookmark[]
  activityLogs   ActivityLog[]
  studyTimers    StudyTimer[]
  studyPlanners  StudyPlanner[]
  materials      UploadedMaterial[]
  topicProgress  TopicProgress[]

  @@index([email])
  @@index([examType])
}

model GATEBranch {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  fullName  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subjects GATESubject[]
  papers   GATEPaper[]
  topics   GATETopic[]

  @@index([code])
}

model GATESubject {
  id        String   @id @default(cuid())
  code      String
  name      String
  branchId  String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch GATEBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  topics  GATETopic[]

  @@unique([code, branchId])
  @@index([branchId])
}

model GATETopic {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  order       Int
  subjectId   String?
  branchId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branch  GATEBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  subject GATESubject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  progress TopicProgress[]

  @@index([branchId])
  @@index([subjectId])
}

model TopicProgress {
  id            String    @id @default(cuid())
  userId        String
  gateTopicId   String?
  examType      ExamType  @default(GATE)
  status        Status    @default(NOT_STARTED)
  masteryScore  Int       @default(0)
  timeSpent     Int       @default(0)
  correctAttempts Int     @default(0)
  totalAttempts  Int      @default(0)
  accuracy       Float    @default(0)
  lastStudiedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  gateTopic GATETopic? @relation(fields: [gateTopicId], references: [id], onDelete: SetNull)

  @@unique([userId, gateTopicId])
  @@index([userId])
  @@index([examType])
}

model GATEPaper {
  id          String   @id @default(cuid())
  year        Int
  session     String?
  paperCode   String
  branchId    String
  setCode     String?
  pdfUrl      String?
  isOfficial  Boolean  @default(true)
  totalMarks  Int      @default(100)
  duration    Int      @default(180)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branch GATEBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([year, paperCode, setCode])
  @@index([branchId])
  @@index([year])
}

model GATEPaperSection {
  id            String @id @default(cuid())
  paperId       String
  name          String
  order         Int
  marks         Int    @default(15)
  questionCount Int    @default(10)

  @@index([paperId])
}

model CATSection {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?  @db.Text
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subsections CATSubsection[]
}

model CATSubsection {
  id          String   @id @default(cuid())
  code        String
  name        String
  sectionId   String
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  section CATSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  topics  CATTopic[]

  @@unique([code, sectionId])
  @@index([sectionId])
}

model CATTopic {
  id           String   @id @default(cuid())
  title        String
  description  String?  @db.Text
  order        Int
  subsectionId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subsection CATSubsection @relation(fields: [subsectionId], references: [id], onDelete: Cascade)

  @@index([subsectionId])
}

model CATPaper {
  id              String   @id @default(cuid())
  year            Int
  slot            String?
  pdfUrl          String?
  isOfficial      Boolean  @default(true)
  totalQuestions  Int      @default(66)
  duration        Int      @default(120)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([year, slot])
  @@index([year])
}

model MCQ {
  id              String        @id @default(cuid())
  question        String        @db.Text
  options         Json
  correctAnswer   Int
  explanation     String?       @db.Text
  examType        ExamType      @default(GATE)
  difficulty      Difficulty    @default(MEDIUM)
  tags            String[]
  
  // GATE
  gateTopicId     String?
  gateBranchCode  String?
  year            Int?
  paperCode       String?
  setCode         String?
  marks           Int           @default(1)
  negativeMarks   Float         @default(0.33)
  questionType    QuestionType   @default(MCQ)
  isPreviousYear  Boolean       @default(false)
  
  // CAT
  catTopicId      String?
  catSectionCode  String?
  catSubsectionCode String?
  slot            String?
  
  // Source
  sourceType      SourceType    @default(OFFICIAL_PAPER)
  sourceUrl       String?
  aiExplanation   String?       @db.Text
  
  avgTimeSpent    Int?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  attempts MCQAttempt[]

  @@index([examType])
  @@index([year])
  @@index([gateBranchCode])
  @@index([catSectionCode])
  @@index([difficulty])
  @@index([gateTopicId])
  @@index([catTopicId])
}

model MCQAttempt {
  id              String    @id @default(cuid())
  userId          String
  mcqId           String
  quizSessionId   String?
  selectedAnswer  Int?
  isCorrect       Boolean
  marksObtained   Float     @default(0)
  negativeMarks   Float     @default(0)
  timeSpent       Int       @default(0)
  isMarkedForReview Boolean @default(false)
  isBookmarked    Boolean   @default(false)
  startedAt       DateTime  @default(now())
  submittedAt     DateTime?

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  mcq         MCQ         @relation(fields: [mcqId], references: [id], onDelete: Cascade)
  quizSession QuizSession? @relation(fields: [quizSessionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([mcqId])
  @@index([quizSessionId])
}

model QuizSession {
  id              String    @id @default(cuid())
  userId          String
  examType        ExamType  @default(GATE)
  mode            QuizMode  @default(PRACTICE)
  sourceType      String    @default("PRACTICE")
  year            Int?
  branchCode      String?
  sectionCode     String?
  totalQuestions  Int
  attemptedCount  Int       @default(0)
  correctCount    Int       @default(0)
  markedForReview Int       @default(0)
  totalMarks      Float     @default(0)
  obtainedMarks   Float     @default(0)
  negativeMarks   Float     @default(0)
  duration        Int
  remainingTime   Int       @default(0)
  isPaused        Boolean   @default(false)
  pausedAt        DateTime?
  totalPaused     Int       @default(0)
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  status          String    @default("IN_PROGRESS")
  autoSubmitted   Boolean   @default(false)

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempts MCQAttempt[]

  @@index([userId])
  @@index([examType])
  @@index([status])
  @@index([year])
}

model StudySession {
  id        String   @id @default(cuid())
  userId    String
  topicId   String?
  startTime DateTime @default(now())
  endTime   DateTime?
  duration  Int      @default(0)
  notes     String?  @db.Text
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RevisionNote {
  id        String   @id @default(cuid())
  userId    String
  topicId   String?
  title     String
  content   String   @db.Text
  tags      String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Flashcard {
  id         String    @id @default(cuid())
  userId     String
  topicId    String?
  front      String
  back       String
  difficulty Difficulty @default(MEDIUM)
  nextReview DateTime?
  reviewCount Int      @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  mcqId     String?
  topicId   String?
  notes     String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  details   Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model StudyTimer {
  id          String    @id @default(cuid())
  userId      String
  topicId     String?
  sessionType String    @default("study")
  startTime   DateTime  @default(now())
  endTime     DateTime?
  duration    Int       @default(0)
  isActive    Boolean   @default(true)
  pausedAt    DateTime?
  totalPaused Int       @default(0)
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([startTime])
}

model StudyPlanner {
  id              String   @id @default(cuid())
  userId          String
  examType        ExamType @default(GATE)
  branchCode      String?
  title           String
  targetDate      DateTime
  dailyHours      Float    @default(4)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UploadedMaterial {
  id          String   @id @default(cuid())
  userId      String
  title       String
  fileName    String?
  fileUrl     String?
  content     String?  @db.Text
  sourceType  SourceType @default(PDF_UPLOAD)
  topicCount  Int     @default(0)
  mcqCount    Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}